# Umhlaba Wami — Environment Variables
# Copy to .env.local for local development.
# For Vercel: Project Settings → Environment Variables

# --- Phase 2: Supabase (optional — app falls back to local demo mode if unset) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here

# Set to "true" to force demo/localStorage mode even if Supabase keys are present
# VITE_FORCE_DEMO_MODE=false
